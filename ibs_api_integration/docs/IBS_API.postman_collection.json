{
  "info": {
    "name": "IBS API Integration",
    "_postman_id": "ibs-api-integration-v1",
    "description": "Complete test collection for the IBS API Integration Odoo module.\n\n**Setup**\n1. Set the `base_url` collection variable to your Odoo server (e.g. `http://localhost:8069`).\n2. Set `db`, `odoo_username`, and `odoo_password` collection variables.\n3. Run **Authentication / Get Token** — it saves the token automatically.\n4. Run any other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:8069", "type": "string" },
    { "key": "db",             "value": "odoo",                  "type": "string" },
    { "key": "odoo_username",  "value": "admin",                 "type": "string" },
    { "key": "odoo_password",  "value": "admin",                 "type": "string" },
    { "key": "access_token",   "value": "",                      "type": "string" },
    { "key": "order_id",       "value": "1",                     "type": "string" },
    { "key": "partner_id",     "value": "1",                     "type": "string" },
    { "key": "product_id",     "value": "1",                     "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has access_token', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(true);",
                  "    pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('access_token', body.data.access_token);",
                  "});",
                  "pm.test('Response has uid and company_id', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.data.uid).to.be.a('number');",
                  "    pm.expect(body.data.company_id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "db",       "value": "{{db}}" },
              { "key": "username", "value": "{{odoo_username}}" },
              { "key": "password", "value": "{{odoo_password}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/token", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "token"] }
          }
        },
        {
          "name": "Revoke Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token revoked', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(true);",
                  "    pm.expect(body.data.revoked).to.eql(true);",
                  "    pm.collectionVariables.set('access_token', '');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token?access_token={{access_token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token"],
              "query": [{ "key": "access_token", "value": "{{access_token}}" }]
            }
          }
        }
      ]
    },
    {

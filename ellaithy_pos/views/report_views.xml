<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_pivot" model="ir.ui.view"><field name="name">ellaithy.pos.order.pivot</field><field name="model">ellaithy.pos.order</field><field name="arch" type="xml"><pivot string="Sales Analysis"><field name="request_date" type="row" interval="month"/><field name="warehouse_id" type="col"/><field name="amount_total" type="measure"/><field name="amount_tax" type="measure"/><field name="amount_discount" type="measure"/><field name="amount_paid" type="measure"/><field name="margin" type="measure" groups="ellaithy_pos.group_ellaithy_pos_admin"/></pivot></field></record>
    <record id="view_pos_order_graph_trend" model="ir.ui.view"><field name="name">ellaithy.pos.order.graph.trend</field><field name="model">ellaithy.pos.order</field><field name="arch" type="xml"><graph string="Sales Trend" type="line"><field name="request_date" interval="month"/><field name="amount_total" type="measure"/></graph></field></record>
    <record id="view_pos_order_graph_status" model="ir.ui.view"><field name="name">ellaithy.pos.order.graph.status</field><field name="model">ellaithy.pos.order</field><field name="arch" type="xml"><graph string="Orders by Status" type="bar"><field name="state"/><field name="id" type="measure"/></graph></field></record>
    <record id="action_pos_sales_analysis" model="ir.actions.act_window"><field name="name">Sales Analysis</field><field name="res_model">ellaithy.pos.order</field><field name="view_mode">pivot,graph,list</field><field name="domain">[('state','=','done')]</field></record>
    <record id="action_pos_sales_trend_chart" model="ir.actions.act_window"><field name="name">Sales Trend</field><field name="res_model">ellaithy.pos.order</field><field name="view_mode">graph,pivot,list</field><field name="view_id" ref="view_pos_order_graph_trend"/><field name="domain">[('state','=','done')]</field></record>
    <record id="action_pos_order_status_chart" model="ir.actions.act_window"><field name="name">Orders by Status</field><field name="res_model">ellaithy.pos.order</field><field name="view_mode">graph,pivot,list</field><field name="view_id" ref="view_pos_order_graph_status"/></record>

    <record id="view_pos_line_pivot" model="ir.ui.view"><field name="name">ellaithy.pos.order.line.pivot</field><field name="model">ellaithy.pos.order.line</field><field name="arch" type="xml"><pivot string="Product Sales"><field name="category_id" type="row"/><field name="product_id" type="row"/><field name="quantity" type="measure"/><field name="price_total" type="measure"/><field name="discount_amount" type="measure"/><field name="margin" type="measure" groups="ellaithy_pos.group_ellaithy_pos_admin"/></pivot></field></record>
    <record id="view_pos_line_graph" model="ir.ui.view"><field name="name">ellaithy.pos.order.line.graph</field><field name="model">ellaithy.pos.order.line</field><field name="arch" type="xml"><graph string="Product Performance" type="bar"><field name="product_id"/><field name="price_total" type="measure"/></graph></field></record>
    <record id="action_pos_product_sales" model="ir.actions.act_window"><field name="name">Product Sales</field><field name="res_model">ellaithy.pos.order.line</field><field name="view_mode">pivot,graph,list</field></record>
    <record id="action_pos_product_chart" model="ir.actions.act_window"><field name="name">Product Performance</field><field name="res_model">ellaithy.pos.order.line</field><field name="view_mode">graph,pivot,list</field><field name="view_id" ref="view_pos_line_graph"/></record>

    <record id="view_pos_payment_pivot" model="ir.ui.view"><field name="name">ellaithy.pos.payment.pivot</field><field name="model">ellaithy.pos.payment</field><field name="arch" type="xml"><pivot string="Payment Analysis"><field name="payment_method_id" type="row"/><field name="payment_date" type="col" interval="month"/><field name="amount" type="measure"/></pivot></field></record>
    <record id="view_pos_payment_graph" model="ir.ui.view"><field name="name">ellaithy.pos.payment.graph</field><field name="model">ellaithy.pos.payment</field><field name="arch" type="xml"><graph string="Payments by Method" type="bar"><field name="payment_method_id"/><field name="amount" type="measure"/></graph></field></record>
    <record id="action_pos_payment_analysis" model="ir.actions.act_window"><field name="name">Payment Analysis</field><field name="res_model">ellaithy.pos.payment</field><field name="view_mode">pivot,graph,list</field><field name="domain">[('state','=','posted')]</field></record>
    <record id="action_pos_payment_chart" model="ir.actions.act_window"><field name="name">Payments by Method</field><field name="res_model">ellaithy.pos.payment</field><field name="view_mode">graph,pivot,list</field><field name="view_id" ref="view_pos_payment_graph"/><field name="domain">[('state','=','posted')]</field></record>

    <record id="view_pos_stock_move_pivot" model="ir.ui.view"><field name="name">ellaithy.pos.stock.move.pivot</field><field name="model">ellaithy.pos.stock.move</field><field name="arch" type="xml"><pivot string="Stock Movement Analysis"><field name="warehouse_id" type="row"/><field name="product_id" type="row"/><field name="date" type="col" interval="month"/><field name="signed_quantity" type="measure"/></pivot></field></record>
    <record id="action_pos_stock_analysis" model="ir.actions.act_window"><field name="name">Stock Movement Analysis</field><field name="res_model">ellaithy.pos.stock.move</field><field name="view_mode">pivot,graph,list</field><field name="domain">[('posted','=',True)]</field></record>
</odoo>

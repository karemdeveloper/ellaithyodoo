<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ellaithy_pos_payment_method_list" model="ir.ui.view">
        <field name="name">ellaithy.pos.payment.method.list</field>
        <field name="model">ellaithy.pos.payment.method</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="journal_id"/>
                <field name="requires_reference"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ellaithy_pos_payment_method_form" model="ir.ui.view">
        <field name="name">ellaithy.pos.payment.method.form</field>
        <field name="model">ellaithy.pos.payment.method</field>
        <field name="arch" type="xml">
            <form string="Payment Method">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="journal_id"/>
                        <field name="requires_reference"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ellaithy_pos_payment_methods" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">ellaithy.pos.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

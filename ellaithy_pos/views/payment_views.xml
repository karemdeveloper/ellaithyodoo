<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_search" model="ir.ui.view"><field name="name">ellaithy.pos.payment.search</field><field name="model">ellaithy.pos.payment</field><field name="arch" type="xml"><search><field name="name"/><field name="order_id"/><field name="payment_method_id"/><field name="user_id"/><field name="state"/><filter name="posted" string="Posted" domain="[('state','=','posted')]"/><filter name="group_method" string="Payment Method" context="{'group_by':'payment_method_id'}"/><filter name="group_user" string="User" context="{'group_by':'user_id'}"/><filter name="group_month" string="Month" context="{'group_by':'payment_date:month'}"/></search></field></record>
    <record id="view_pos_payment_list" model="ir.ui.view"><field name="name">ellaithy.pos.payment.list</field><field name="model">ellaithy.pos.payment</field><field name="arch" type="xml"><list><field name="name"/><field name="payment_date"/><field name="order_id"/><field name="payment_method_id"/><field name="amount" sum="Total Paid"/><field name="reference"/><field name="user_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_pos_payment_form" model="ir.ui.view"><field name="name">ellaithy.pos.payment.form</field><field name="model">ellaithy.pos.payment</field><field name="arch" type="xml"><form><header><button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="order_id"/><field name="payment_date"/><field name="payment_method_id"/><field name="amount"/><field name="reference"/><field name="user_id"/><field name="note"/></group></sheet></form></field></record>
    <record id="action_pos_payments" model="ir.actions.act_window"><field name="name">Payments</field><field name="res_model">ellaithy.pos.payment</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_pos_payment_search"/></record>
</odoo>

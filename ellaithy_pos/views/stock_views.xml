<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_stock_balance_search" model="ir.ui.view"><field name="name">ellaithy.pos.stock.balance.search</field><field name="model">ellaithy.pos.stock.balance</field><field name="arch" type="xml"><search><field name="product_id"/><field name="warehouse_id"/><filter name="low_stock" string="Low Stock" domain="[('low_stock','=',True)]"/><filter name="group_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/><filter name="group_product" string="Product" context="{'group_by':'product_id'}"/></search></field></record>
    <record id="view_pos_stock_balance_list" model="ir.ui.view"><field name="name">ellaithy.pos.stock.balance.list</field><field name="model">ellaithy.pos.stock.balance</field><field name="arch" type="xml"><list decoration-danger="low_stock"><field name="warehouse_id"/><field name="product_id"/><field name="quantity" sum="On Hand"/><field name="minimum_stock"/><field name="low_stock" widget="boolean_toggle" readonly="1"/></list></field></record>
    <record id="action_pos_stock_balances" model="ir.actions.act_window"><field name="name">Current Stock</field><field name="res_model">ellaithy.pos.stock.balance</field><field name="view_mode">list</field><field name="search_view_id" ref="view_pos_stock_balance_search"/></record>

    <record id="view_pos_stock_move_search" model="ir.ui.view"><field name="name">ellaithy.pos.stock.move.search</field><field name="model">ellaithy.pos.stock.move</field><field name="arch" type="xml"><search><field name="name"/><field name="product_id"/><field name="warehouse_id"/><field name="move_type"/><field name="order_id"/><filter name="not_posted" string="Not Posted" domain="[('posted','=',False)]"/><filter name="group_type" string="Type" context="{'group_by':'move_type'}"/><filter name="group_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/><filter name="group_month" string="Month" context="{'group_by':'date:month'}"/></search></field></record>
    <record id="view_pos_stock_move_list" model="ir.ui.view"><field name="name">ellaithy.pos.stock.move.list</field><field name="model">ellaithy.pos.stock.move</field><field name="arch" type="xml"><list decoration-muted="not posted"><field name="name"/><field name="date"/><field name="move_type"/><field name="warehouse_id"/><field name="product_id"/><field name="quantity"/><field name="direction"/><field name="signed_quantity" sum="Net Qty"/><field name="order_id"/><field name="user_id"/><field name="posted"/></list></field></record>
    <record id="view_pos_stock_move_form" model="ir.ui.view"><field name="name">ellaithy.pos.stock.move.form</field><field name="model">ellaithy.pos.stock.move</field><field name="arch" type="xml"><form><header><button name="action_post" type="object" string="Post Movement" class="btn-primary" invisible="posted"/></header><sheet><group><group><field name="name"/><field name="date"/><field name="move_type"/><field name="warehouse_id"/><field name="product_id"/></group><group><field name="quantity"/><field name="direction"/><field name="signed_quantity" readonly="1"/><field name="order_id" readonly="1"/><field name="user_id"/><field name="posted" readonly="1"/></group></group><field name="note"/></sheet></form></field></record>
    <record id="action_pos_stock_moves" model="ir.actions.act_window"><field name="name">Stock Movements</field><field name="res_model">ellaithy.pos.stock.move</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_pos_stock_move_search"/></record>
    <record id="action_pos_stock_adjustment" model="ir.actions.act_window"><field name="name">New Stock Adjustment</field><field name="res_model">ellaithy.pos.stock.move</field><field name="view_mode">form</field><field name="context">{'default_move_type':'adjust_in','default_direction':'in'}</field><field name="target">current</field></record>
</odoo>

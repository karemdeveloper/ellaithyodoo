<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_category_list" model="ir.ui.view"><field name="name">ellaithy.pos.category.list</field><field name="model">ellaithy.pos.category</field><field name="arch" type="xml"><list><field name="name"/><field name="parent_id"/><field name="active"/></list></field></record>
    <record id="view_pos_category_form" model="ir.ui.view"><field name="name">ellaithy.pos.category.form</field><field name="model">ellaithy.pos.category</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="parent_id"/><field name="active"/></group><field name="note"/></sheet></form></field></record>
    <record id="action_pos_categories" model="ir.actions.act_window"><field name="name">Product Categories</field><field name="res_model">ellaithy.pos.category</field><field name="view_mode">list,form</field></record>

    <record id="view_pos_product_search" model="ir.ui.view"><field name="name">ellaithy.pos.product.search</field><field name="model">ellaithy.pos.product</field><field name="arch" type="xml"><search><field name="name"/><field name="sku"/><field name="barcode"/><field name="category_id"/><filter name="active_products" string="Active" domain="[('active','=',True)]"/><filter name="group_category" string="Category" context="{'group_by':'category_id'}"/></search></field></record>
    <record id="view_pos_product_list" model="ir.ui.view"><field name="name">ellaithy.pos.product.list</field><field name="model">ellaithy.pos.product</field><field name="arch" type="xml"><list decoration-warning="total_on_hand &lt;= minimum_stock"><field name="sku"/><field name="barcode" optional="hide"/><field name="name"/><field name="category_id"/><field name="uom"/><field name="sale_price"/><field name="cost_price" groups="ellaithy_pos.group_ellaithy_pos_admin"/><field name="tax_percent"/><field name="total_on_hand"/><field name="minimum_stock"/><field name="active"/></list></field></record>
    <record id="view_pos_product_form" model="ir.ui.view"><field name="name">ellaithy.pos.product.form</field><field name="model">ellaithy.pos.product</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="sku"/><field name="barcode"/><field name="category_id"/><field name="uom"/><field name="active"/></group><group><field name="sale_price"/><field name="cost_price"/><field name="tax_percent"/><field name="track_stock"/><field name="minimum_stock"/><field name="total_on_hand" readonly="1"/></group></group><notebook><page string="Stock by Warehouse"><field name="stock_balance_ids" readonly="1"><list><field name="warehouse_id"/><field name="quantity"/><field name="minimum_stock"/><field name="low_stock"/></list></field></page><page string="Notes"><field name="note"/></page></notebook></sheet></form></field></record>
    <record id="action_pos_products" model="ir.actions.act_window"><field name="name">Products</field><field name="res_model">ellaithy.pos.product</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_pos_product_search"/></record>

    <record id="view_pos_customer_list" model="ir.ui.view"><field name="name">ellaithy.pos.customer.list</field><field name="model">ellaithy.pos.customer</field><field name="arch" type="xml"><list><field name="name"/><field name="phone"/><field name="mobile"/><field name="email"/><field name="tax_number"/><field name="active"/></list></field></record>
    <record id="view_pos_customer_form" model="ir.ui.view"><field name="name">ellaithy.pos.customer.form</field><field name="model">ellaithy.pos.customer</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="phone"/><field name="mobile"/><field name="email"/></group><group><field name="tax_number"/><field name="active"/></group></group><field name="address"/><field name="note"/></sheet></form></field></record>
    <record id="action_pos_customers" model="ir.actions.act_window"><field name="name">Customers</field><field name="res_model">ellaithy.pos.customer</field><field name="view_mode">list,form</field></record>

    <record id="view_pos_warehouse_list" model="ir.ui.view"><field name="name">ellaithy.pos.warehouse.list</field><field name="model">ellaithy.pos.warehouse</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="location"/><field name="responsible_id"/><field name="active"/></list></field></record>
    <record id="view_pos_warehouse_form" model="ir.ui.view"><field name="name">ellaithy.pos.warehouse.form</field><field name="model">ellaithy.pos.warehouse</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="location"/><field name="responsible_id"/><field name="active"/></group><field name="note"/></sheet></form></field></record>
    <record id="action_pos_warehouses" model="ir.actions.act_window"><field name="name">Warehouses</field><field name="res_model">ellaithy.pos.warehouse</field><field name="view_mode">list,form</field></record>

    <record id="view_pos_payment_method_list" model="ir.ui.view"><field name="name">ellaithy.pos.payment.method.list</field><field name="model">ellaithy.pos.payment.method</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="requires_reference"/><field name="allow_partial"/><field name="active"/></list></field></record>
    <record id="view_pos_payment_method_form" model="ir.ui.view"><field name="name">ellaithy.pos.payment.method.form</field><field name="model">ellaithy.pos.payment.method</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="sequence"/><field name="requires_reference"/><field name="allow_partial"/><field name="active"/></group><field name="note"/></sheet></form></field></record>
    <record id="action_pos_payment_methods" model="ir.actions.act_window"><field name="name">Payment Methods</field><field name="res_model">ellaithy.pos.payment.method</field><field name="view_mode">list,form</field></record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_compare_dashboard" model="ir.actions.client">
        <field name="name">Marketing Dashboard</field>
        <field name="tag">compare_module_importable.CompareDashboard</field>
    </record>

    <!-- Backward-compatible redirect for databases that installed v9.
         The old My Sales Dashboard action now opens the Charts tab
         inside the main Compare dashboard. -->
    <record id="action_sales_access_dashboard" model="ir.actions.client">
        <field name="name">My Sales Dashboard</field>
        <field name="tag">compare_module_importable.CompareDashboard</field>
        <field name="context">{'default_tab': 'charts'}</field>
    </record>
</odoo>

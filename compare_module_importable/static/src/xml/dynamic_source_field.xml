<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="compare_module_importable.DynamicSourceField">
        <t t-if="props.readonly">
            <span t-esc="value || 'Not entered'"/>
        </t>
        <t t-else="">
            <select class="o_input" t-on-change="onChange" t-att-disabled="state.loading">
                <option value="" t-att-selected="!value">
                    <t t-esc="state.loading ? 'Loading configured sources…' : 'Select a source'"/>
                </option>
                <option t-foreach="state.options" t-as="option" t-key="option" t-att-value="option" t-att-selected="option === value">
                    <t t-esc="option"/>
                </option>
            </select>
        </t>
    </t>

    <t t-name="compare_module_importable.DynamicSourcesField">
        <t t-if="props.readonly">
            <div class="cmp-source-tags">
                <span t-foreach="displayValues" t-as="source" t-key="source" class="badge rounded-pill text-bg-secondary" t-esc="source"/>
                <span t-if="!displayValues.length" class="text-muted">Not entered</span>
            </div>
        </t>
        <t t-else="">
            <div class="cmp-source-picker">
                <div class="cmp-source-picker-header">
                    <input type="search" class="o_input" t-model="state.query" placeholder="Search configured sources…"/>
                    <span class="badge rounded-pill text-bg-primary">
                        <t t-esc="selectedValues.length"/> selected
                    </span>
                </div>
                <div class="cmp-source-picker-options">
                    <div t-if="state.loading" class="text-muted py-2">Loading configured sources…</div>
                    <label t-foreach="filteredOptions" t-as="source" t-key="source" class="cmp-source-option">
                        <input type="checkbox" class="form-check-input" t-att-data-source="source" t-att-checked="isSelected(source)" t-on-change="onToggle"/>
                        <span t-esc="source"/>
                    </label>
                    <div t-if="!state.loading &amp;&amp; !filteredOptions.length" class="text-muted py-2">No matching configured sources.</div>
                </div>
            </div>
        </t>
    </t>
</templates>

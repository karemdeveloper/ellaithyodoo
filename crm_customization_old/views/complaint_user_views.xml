<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== COMPLAINT USER =================== -->
    <record id="view_complaint_user_list" model="ir.ui.view">
        <field name="name">complaint.user.list</field>
        <field name="model">complaint.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_complaint_user_form" model="ir.ui.view">
        <field name="name">complaint.user</field>
        <field name="model">complaint.user</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                 <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="action_complaint_user" model="ir.actions.act_window">
        <field name="name"> Complaint User</field>
        <field name="res_model">complaint.user</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="menu_complaint_user"
              name="Complaint User"
              parent="crm.crm_menu_config"
              action="action_complaint_user"
              sequence="2"/>


</odoo>
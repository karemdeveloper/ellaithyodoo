<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_offer_bank_list" model="ir.ui.view">
        <field name="name">bank.offer.bank.list</field>
        <field name="model">bank.offer.bank</field>
        <field name="arch" type="xml">
            <list string="Banks" default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="sale_ban_fee"/>
                <field name="last_verified_date"/>
                <field name="verified_by_id" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bank_offer_bank_form" model="ir.ui.view">
        <field name="name">bank.offer.bank.form</field>
        <field name="model">bank.offer.bank</field>
        <field name="arch" type="xml">
            <form string="Bank">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_programs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="program_count" widget="statinfo" string="Programs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sale_ban_fee"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="last_verified_date"/>
                            <field name="verified_by_id"/>
                            <field name="website"/>
                        </group>
                    </group>
                    <group string="Contact">
                        <field name="contact_name"/>
                        <field name="contact_phone"/>
                        <field name="contact_email"/>
                    </group>
                    <notebook>
                        <page string="Programs">
                            <field name="program_ids" context="{'default_bank_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="vehicle_type"/>
                                    <field name="min_downpayment_pct"/>
                                    <field name="max_downpayment_pct"/>
                                    <field name="min_term_months"/>
                                    <field name="max_term_months"/>
                                    <field name="approval_days"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes" placeholder="Bank-specific notes, update source, policy details..."/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bank_offer_banks" model="ir.actions.act_window">
        <field name="name">Banks</field><field name="res_model">bank.offer.bank</field><field name="view_mode">list,form</field>
    </record>
</odoo>

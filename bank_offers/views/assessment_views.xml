<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_offer_assessment_search" model="ir.ui.view">
        <field name="name">bank.offer.assessment.search</field><field name="model">bank.offer.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="customer_name"/><field name="phone"/><field name="user_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_calculated" string="Calculated" domain="[('state','=','calculated')]"/>
                <filter name="my_assessments" string="My Assessments" domain="[('user_id','=',uid)]"/>
                <group expand="0" string="Group By"><filter name="group_by_sales_user" string="Sales User" context="{'group_by':'user_id'}"/><filter name="group_by_date" string="Date" context="{'group_by':'assessment_date'}"/></group>
            </search>
        </field>
    </record>

    <record id="view_bank_offer_assessment_list" model="ir.ui.view">
        <field name="name">bank.offer.assessment.list</field><field name="model">bank.offer.assessment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'calculated'">
                <field name="name"/><field name="assessment_date" string="تاريخ التقييم"/><field name="customer_name"/><field name="job_type_id"/>
                <field name="monthly_income"/><field name="car_price"/><field name="down_payment"/><field name="term_months" string="عدد شهور التقسيط"/>
                <field name="eligible_count"/><field name="user_id" groups="bank_offers.group_bank_offers_manager"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bank_offer_assessment_form" model="ir.ui.view">
        <field name="name">bank.offer.assessment.form</field><field name="model">bank.offer.assessment</field>
        <field name="arch" type="xml">
            <form string="Financing Pre-Assessment">
                <header>
                    <button name="action_calculate" type="object" string="Calculate &amp; Recommend" class="btn-primary" invisible="state == 'calculated'"/>
                    <button name="action_calculate" type="object" string="Recalculate" class="btn-secondary" invisible="state != 'calculated'"/>
                    <button name="action_open_result_popup" type="object" string="View Results / Print" class="btn-primary" icon="fa-print" invisible="state != 'calculated'"/>
                    <button name="action_reset_draft" type="object" string="Reset" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Customer">
                            <field name="customer_name"/><field name="phone"/><field name="monthly_income"/>
                            <field name="job_type_id"/><field name="age"/>
                        </group>
                        <group string="Vehicle &amp; Finance">
                            <field name="vehicle_type"/><field name="vehicle_model_year" invisible="vehicle_type != 'used'"/>
                            <field name="car_price"/><field name="down_payment"/><field name="downpayment_pct" readonly="1"/>
                            <field name="finance_amount" readonly="1"/><field name="term_months" string="عدد شهور التقسيط"/>
                        </group>
                    </group>
                    <group>
                        <field name="assessment_date" string="تاريخ التقييم"/><field name="user_id" groups="bank_offers.group_bank_offers_manager"/>
                        <field name="eligible_count" readonly="1"/>
                    </group>
                    <separator string="Recommended Offers"/>
                    <field name="result_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0" decoration-success="rank == 1" decoration-info="rank == 2">
                            <field name="rank"/>
                            <field name="bank_id" options="{'no_open': True}"/>
                            <field name="program_id" options="{'no_open': True}"/>
                            <field name="annual_interest_rate"/>
                            <field name="interest_method"/>
                            <field name="monthly_installment"/>
                            <field name="installment_income_pct"/>
                            <field name="approval_days"/>
                            <field name="insurance_required" optional="show"/>
                            <field name="insurance_rate_pct" optional="show"/>
                            <field name="annual_insurance_amount" optional="show"/>
                            <field name="admin_fee" optional="show"/>
                            <field name="sale_ban_fee" string="مصاريف الحظر الإلكتروني" optional="show"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Sales notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_offer_assessment_result_popup" model="ir.ui.view">
        <field name="name">bank.offer.assessment.result.popup</field>
        <field name="model">bank.offer.assessment</field>
        <field name="arch" type="xml">
            <form string="نتيجة عروض البنوك" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h2>نتيجة عروض البنوك</h2>
                    </div>

                    <group>
                        <group string="بيانات العميل">
                            <field name="customer_name" string="اسم العميل" readonly="1"/>
                            <field name="phone" string="الهاتف" readonly="1"/>
                            <field name="monthly_income" string="الدخل الشهري" readonly="1"/>
                            <field name="job_type_id" string="نوع الوظيفة" readonly="1" options="{'no_open': True}"/>
                            <field name="age" string="العمر" readonly="1"/>
                        </group>
                        <group string="بيانات التمويل">
                            <field name="vehicle_type" string="نوع السيارة" readonly="1"/>
                            <field name="car_price" string="سعر السيارة" readonly="1"/>
                            <field name="down_payment" string="المقدم" readonly="1"/>
                            <field name="finance_amount" string="مبلغ التمويل" readonly="1"/>
                            <field name="term_months" string="عدد شهور التقسيط" readonly="1"/>
                            <field name="today_date" string="تاريخ اليوم" readonly="1"/>
                        </group>
                    </group>

                    <separator string="العروض المتاحة - أولوية البنوك: ADIB ثم NBK ثم ABK ثم FAB"/>
                    <field name="result_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0" decoration-success="rank == 1" decoration-info="rank == 2">
                            <field name="rank" string="الترتيب"/>
                            <field name="bank_id" string="البنك" options="{'no_open': True}"/>
                            <field name="program_id" string="البرنامج" options="{'no_open': True}"/>
                            <field name="annual_interest_rate" string="الفائدة %"/>
                            <field name="monthly_installment" string="القسط الشهري"/>
                            <field name="sale_ban_fee" string="مصاريف الحظر الإلكتروني"/>
                            <field name="approval_days" string="أيام الموافقة" optional="show"/>
                            <field name="insurance_required" string="التأمين مطلوب" optional="show"/>
                            <field name="admin_fee" string="المصاريف الإدارية" optional="show"/>
                        </list>
                    </field>

                    <div class="mt-4" dir="rtl" style="font-size: 14px; line-height: 1.9;">
                        <p><strong>الشروط والأحكام:</strong></p>
                        <p>• تم احتساب قيمة الفائدة والقسط الشهري بشكل مبدئي لحين صدور الموافقة البنكية بالقيمة النهائية والصحيحة.</p>
                        <p>• السعر النهائي للسيارة يُحدد عند الاستلام.</p>
                        <p>• تطبق الشروط والأحكام.</p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_print_recommendation" type="object" string="طباعة" class="btn-primary" icon="fa-print"/>
                    <button string="إغلاق" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_offer_assessments" model="ir.actions.act_window">
        <field name="name">Pre-Assessments</field><field name="res_model">bank.offer.assessment</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_offer_assessment_search"/>
        <field name="context">{'search_default_my_assessments': 1}</field>
    </record>
</odoo>

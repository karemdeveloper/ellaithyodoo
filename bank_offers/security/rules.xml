<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bank_offer_assessment_user_own" model="ir.rule">
        <field name="name">Bank Offer Assessments - own only</field>
        <field name="model_id" ref="model_bank_offer_assessment"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bank_offers.group_bank_offers_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bank_offer_assessment_manager_all" model="ir.rule">
        <field name="name">Bank Offer Assessments - managers all</field>
        <field name="model_id" ref="model_bank_offer_assessment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bank_offers.group_bank_offers_manager'))]"/>
    </record>

    <record id="rule_bank_offer_result_user_own" model="ir.rule">
        <field name="name">Bank Offer Results - own assessments</field>
        <field name="model_id" ref="model_bank_offer_assessment_result"/>
        <field name="domain_force">[('assessment_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bank_offers.group_bank_offers_user'))]"/>
    </record>

    <record id="rule_bank_offer_result_manager_all" model="ir.rule">
        <field name="name">Bank Offer Results - managers all</field>
        <field name="model_id" ref="model_bank_offer_assessment_result"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bank_offers.group_bank_offers_manager'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bank_offers" model="ir.module.category">
        <field name="name">Bank Offers</field>
        <field name="description">Bank financing programs and customer pre-assessment</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_bank_offers_user" model="res.groups">
        <field name="name">Bank Offers User</field>
        <field name="category_id" ref="bank_offers.module_category_bank_offers"/>
    </record>

    <record id="group_bank_offers_manager" model="res.groups">
        <field name="name">Bank Offers Configuration Manager</field>
        <field name="category_id" ref="bank_offers.module_category_bank_offers"/>
        <field name="implied_ids" eval="[(4, ref('bank_offers.group_bank_offers_user'))]"/>
    </record>
</odoo>

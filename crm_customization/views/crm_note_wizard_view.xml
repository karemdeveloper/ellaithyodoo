<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_note_wizard_form" model="ir.ui.view">
        <field name="name">crm.note.wizard.form</field>
        <field name="model">crm.note.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Note">
                <div class="alert alert-info" role="alert" invisible="not new_stage_id">
                    Changing the stage requires a note. This opportunity will move from
                    <strong><field name="current_stage_id" readonly="1" nolabel="1" class="oe_inline"/></strong>
                    to
                    <strong><field name="new_stage_id" readonly="1" nolabel="1" class="oe_inline"/></strong>
                    once you confirm.
                </div>
                <group>
                    <field name="lead_ids" invisible="1"/>

                    <field name="date"/>
                    <field name="salesperson_id"/>
                    <field name="note" required="1"/>
                    

                </group>
                <footer>
                    <button string="Add Note" type="object" name="action_add_note" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_crm_note_wizard" model="ir.actions.act_window">
        <field name="name">Add Note</field>
        <field name="res_model">crm.note.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

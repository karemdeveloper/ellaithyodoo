<odoo>
    <record id="view_ellaithy_drive_backup_log_list" model="ir.ui.view">
        <field name="name">ellaithy.drive.backup.log.list</field>
        <field name="model">ellaithy.drive.backup.log</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="config_id"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="status"/>
                <field name="filename"/>
                <field name="size_bytes"/>
                <field name="drive_web_view_link" widget="url"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="action_ellaithy_drive_backup_log" model="ir.actions.act_window">
        <field name="name">Backup History</field>
        <field name="res_model">ellaithy.drive.backup.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

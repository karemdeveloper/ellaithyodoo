<odoo>
    <record id="view_ellaithy_drive_backup_config_list" model="ir.ui.view">
        <field name="name">ellaithy.drive.backup.config.list</field>
        <field name="model">ellaithy.drive.backup.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="google_connected"/>
                <field name="backup_format"/>
                <field name="schedule_enabled"/>
                <field name="next_backup_at"/>
                <field name="last_success_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ellaithy_drive_backup_config_form" model="ir.ui.view">
        <field name="name">ellaithy.drive.backup.config.form</field>
        <field name="model">ellaithy.drive.backup.config</field>
        <field name="arch" type="xml">
            <form string="Google Drive Backup">
                <header>
                    <button name="action_backup_now" string="Backup Now" type="object" class="btn-primary" invisible="not google_connected"/>
                    <button name="action_test_connection" string="Test Google Drive" type="object" invisible="not google_connected"/>
                    <button name="action_connect_google" string="Connect Google Drive" type="object" class="btn-secondary" invisible="google_connected"/>
                    <button name="action_disconnect_google" string="Disconnect" type="object" class="btn-secondary" invisible="not google_connected" confirm="Disconnect this Google Drive account?"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Google Drive">
                            <field name="google_connected" readonly="1"/>
                            <field name="google_client_id" password="True"/>
                            <field name="google_client_secret" password="True"/>
                            <field name="google_folder_name"/>
                            <field name="google_folder_id" placeholder="Optional — leave empty to create automatically"/>
                            <field name="google_refresh_token" password="True" readonly="1" invisible="not google_connected"/>
                        </group>
                        <group string="Backup">
                            <field name="backup_format"/>
                            <field name="filename_prefix"/>
                            <field name="retention_days"/>
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="schedule_enabled"/>
                            <field name="backup_time" widget="float_time" invisible="not schedule_enabled"/>
                            <field name="timezone" invisible="not schedule_enabled"/>
                            <field name="next_backup_at" readonly="1" invisible="not schedule_enabled"/>
                        </group>
                        <group string="Status">
                            <field name="last_backup_at" readonly="1"/>
                            <field name="last_success_at" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Backup History">
                            <field name="log_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                    <field name="status"/>
                                    <field name="filename"/>
                                    <field name="size_bytes"/>
                                    <field name="drive_web_view_link" widget="url"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ellaithy_drive_backup_config" model="ir.actions.act_window">
        <field name="name">Backup Configurations</field>
        <field name="res_model">ellaithy.drive.backup.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ellaithy_whatsapp" model="ir.module.category">
        <field name="name">Ellaithy WhatsApp</field>
        <field name="description">WhatsApp inbox and configuration permissions</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">WhatsApp User</field>
        <field name="category_id" ref="module_category_ellaithy_whatsapp"/>
    </record>

    <record id="group_whatsapp_supervisor" model="res.groups">
        <field name="name">WhatsApp Supervisor</field>
        <field name="category_id" ref="module_category_ellaithy_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
    </record>

    <record id="group_whatsapp_admin" model="res.groups">
        <field name="name">WhatsApp Administrator</field>
        <field name="category_id" ref="module_category_ellaithy_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_supervisor'))]"/>
    </record>

    <record id="rule_whatsapp_conversation_user" model="ir.rule">
        <field name="name">WhatsApp User - Assigned/Unassigned Conversations</field>
        <field name="model_id" ref="model_ellaithy_whatsapp_conversation"/>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="domain_force">['|', ('assigned_user_id', '=', user.id), ('assigned_user_id', '=', False)]</field>
    </record>

    <record id="rule_whatsapp_message_user" model="ir.rule">
        <field name="name">WhatsApp User - Assigned/Unassigned Messages</field>
        <field name="model_id" ref="model_ellaithy_whatsapp_message"/>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="domain_force">['|', ('conversation_id.assigned_user_id', '=', user.id), ('conversation_id.assigned_user_id', '=', False)]</field>
    </record>

    <record id="rule_whatsapp_conversation_supervisor" model="ir.rule">
        <field name="name">WhatsApp Supervisor - All Conversations</field>
        <field name="model_id" ref="model_ellaithy_whatsapp_conversation"/>
        <field name="groups" eval="[(4, ref('group_whatsapp_supervisor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_whatsapp_message_supervisor" model="ir.rule">
        <field name="name">WhatsApp Supervisor - All Messages</field>
        <field name="model_id" ref="model_ellaithy_whatsapp_message"/>
        <field name="groups" eval="[(4, ref('group_whatsapp_supervisor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>

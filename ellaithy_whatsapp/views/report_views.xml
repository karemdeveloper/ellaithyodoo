<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_message_graph" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.message.graph</field><field name="model">ellaithy.whatsapp.message</field>
        <field name="arch" type="xml"><graph string="WhatsApp Messages" type="bar"><field name="message_date" interval="day"/><field name="direction"/><field name="report_count" type="measure" string="Messages"/></graph></field>
    </record>
    <record id="view_whatsapp_message_pivot" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.message.pivot</field><field name="model">ellaithy.whatsapp.message</field>
        <field name="arch" type="xml"><pivot string="WhatsApp Message Analysis"><field name="message_date" type="row" interval="month"/><field name="direction" type="col"/><field name="status" type="col"/><field name="report_count" type="measure" string="Messages"/></pivot></field>
    </record>
    <record id="view_whatsapp_conversation_graph" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.conversation.graph</field><field name="model">ellaithy.whatsapp.conversation</field>
        <field name="arch" type="xml"><graph string="Conversations by Agent" type="bar"><field name="assigned_user_id"/><field name="report_count" type="measure" string="Conversations"/></graph></field>
    </record>
    <record id="view_whatsapp_conversation_pivot" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.conversation.pivot</field><field name="model">ellaithy.whatsapp.conversation</field>
        <field name="arch" type="xml"><pivot string="Conversation Performance"><field name="assigned_user_id" type="row"/><field name="state" type="col"/><field name="report_count" type="measure" string="Conversations"/><field name="first_response_minutes" type="measure"/><field name="resolution_minutes" type="measure"/></pivot></field>
    </record>
    <record id="action_whatsapp_message_charts" model="ir.actions.act_window"><field name="name">Message Charts</field><field name="res_model">ellaithy.whatsapp.message</field><field name="view_mode">graph,pivot,list</field></record>
    <record id="action_whatsapp_conversation_reports" model="ir.actions.act_window"><field name="name">Conversation Performance</field><field name="res_model">ellaithy.whatsapp.conversation</field><field name="view_mode">graph,pivot,list</field></record>
</odoo>

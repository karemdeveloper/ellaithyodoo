<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_template_list" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.template.list</field>
        <field name="model">ellaithy.whatsapp.template</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="meta_name"/><field name="account_id"/><field name="language_code"/><field name="category"/><field name="variable_count"/><field name="active"/></list></field>
    </record>
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.template.form</field>
        <field name="model">ellaithy.whatsapp.template</field>
        <field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="account_id"/><field name="meta_name"/><field name="language_code"/><field name="category"/></group><group><field name="variable_count"/><field name="active"/></group></group><group><field name="body_preview"/><field name="notes"/></group></sheet></form></field>
    </record>
    <record id="action_whatsapp_templates" model="ir.actions.act_window"><field name="name">WhatsApp Templates</field><field name="res_model">ellaithy.whatsapp.template</field><field name="view_mode">list,form</field></record>
</odoo>

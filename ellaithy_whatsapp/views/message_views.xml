<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_message_search" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.message.search</field>
        <field name="model">ellaithy.whatsapp.message</field>
        <field name="arch" type="xml">
            <search><field name="conversation_id"/><field name="body"/><field name="status"/><filter name="failed" string="Failed" domain="[('status','=','failed')]"/><group expand="0" string="Group By"><filter name="group_direction" string="Direction" context="{'group_by':'direction'}"/><filter name="group_type" string="Type" context="{'group_by':'message_type'}"/><filter name="group_status" string="Status" context="{'group_by':'status'}"/><filter name="group_day" string="Day" context="{'group_by':'message_date:day'}"/></group></search>
        </field>
    </record>
    <record id="view_whatsapp_message_list" model="ir.ui.view"><field name="name">ellaithy.whatsapp.message.list</field><field name="model">ellaithy.whatsapp.message</field><field name="arch" type="xml"><list create="0"><field name="message_date"/><field name="conversation_id"/><field name="direction"/><field name="message_type"/><field name="body"/><field name="status"/><field name="sent_by_id"/><field name="error_message" optional="hide"/></list></field></record>
    <record id="view_whatsapp_message_form" model="ir.ui.view"><field name="name">ellaithy.whatsapp.message.form</field><field name="model">ellaithy.whatsapp.message</field><field name="arch" type="xml"><form create="0"><sheet><group><group><field name="conversation_id"/><field name="direction"/><field name="message_type"/><field name="message_date"/><field name="sent_by_id"/></group><group><field name="status"/><field name="meta_message_id"/><field name="template_id"/><field name="attachment_id"/></group></group><field name="body"/><field name="error_message"/><field name="raw_payload" groups="ellaithy_whatsapp.group_whatsapp_admin"/></sheet></form></field></record>
    <record id="action_whatsapp_messages" model="ir.actions.act_window"><field name="name">Message History</field><field name="res_model">ellaithy.whatsapp.message</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_whatsapp_message_search"/></record>
</odoo>

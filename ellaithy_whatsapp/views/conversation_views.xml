<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_conversation_search" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.conversation.search</field>
        <field name="model">ellaithy.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="phone"/><field name="contact_name"/><field name="partner_id"/><field name="assigned_user_id"/>
                <filter name="my_conversations" string="My Conversations" domain="[('assigned_user_id','=',uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('assigned_user_id','=',False)]"/>
                <filter name="unread" string="Unread" domain="[('unread_count','&gt;',0)]"/>
                <filter name="open" string="Open" domain="[('state','in',['new','open','waiting_customer','waiting_internal'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by':'assigned_user_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by':'team_id'}"/>
                    <filter name="group_account" string="Account" context="{'group_by':'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_whatsapp_conversation_list" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.conversation.list</field>
        <field name="model">ellaithy.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <list decoration-info="unread_count &gt; 0" decoration-muted="state == 'closed'">
                <field name="last_message_at"/>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="last_message_preview"/>
                <field name="unread_count"/>
                <field name="team_id"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_conversation_kanban" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.conversation.kanban</field>
        <field name="model">ellaithy.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/><field name="phone"/><field name="contact_name"/><field name="last_message_at"/><field name="last_message_preview"/><field name="unread_count"/><field name="assigned_user_id"/><field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold"><field name="contact_name"/> <span t-if="record.unread_count.raw_value" class="badge text-bg-success"><field name="unread_count"/></span></div>
                        <div class="text-muted"><field name="phone"/></div>
                        <div class="mt-2 text-truncate"><field name="last_message_preview"/></div>
                        <div class="mt-2 d-flex justify-content-between"><field name="assigned_user_id" widget="many2one_avatar_user"/><field name="last_message_at"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.conversation.form</field>
        <field name="model">ellaithy.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Conversation">
                <header>
                    <button name="action_open_send_wizard" string="Send Message" type="object" class="btn-primary" icon="fa-paper-plane" invisible="state == 'closed'"/>
                    <button name="action_mark_read" string="Mark Read" type="object" invisible="unread_count == 0"/>
                    <button name="action_resolve" string="Resolve" type="object" class="btn-success" invisible="state in ['resolved','closed']"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="state not in ['resolved','closed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,open,waiting_customer,waiting_internal,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partner" type="object" class="oe_stat_button" icon="fa-user" invisible="not partner_id"><div class="o_stat_info"><span class="o_stat_text">Contact</span></div></button>
                        <button name="action_open_crm" type="object" class="oe_stat_button" icon="fa-filter" invisible="not crm_lead_id"><div class="o_stat_info"><span class="o_stat_text">CRM</span></div></button>
                        <button name="action_open_complaint" type="object" class="oe_stat_button" icon="fa-exclamation-circle" invisible="not complaint_id"><div class="o_stat_info"><span class="o_stat_text">Complaint</span></div></button>
                        <button name="action_open_helpdesk" type="object" class="oe_stat_button" icon="fa-life-ring" invisible="not helpdesk_ticket_id"><div class="o_stat_info"><span class="o_stat_text">Helpdesk</span></div></button>
                    </div>
                    <div class="oe_title"><h1><field name="contact_name" placeholder="Contact Name"/></h1><h3><field name="phone"/></h3></div>
                    <group>
                        <group><field name="account_id"/><field name="partner_id"/><field name="crm_lead_id"/><field name="complaint_id"/><field name="helpdesk_ticket_id"/></group>
                        <group><field name="team_id"/><field name="assigned_user_id" widget="many2one_avatar_user"/><field name="unread_count" readonly="1"/><field name="last_message_at" readonly="1"/></group>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" default_order="message_date desc" decoration-success="direction == 'inbound'" decoration-info="direction == 'outbound'" decoration-danger="status == 'failed'">
                                    <field name="message_date"/><field name="direction"/><field name="message_type"/><field name="body"/><field name="attachment_id"/><field name="status"/><field name="sent_by_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Metrics"><group><field name="first_response_at"/><field name="first_response_minutes"/><field name="resolved_at"/><field name="resolution_minutes"/></group></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_conversations" model="ir.actions.act_window">
        <field name="name">WhatsApp Inbox</field>
        <field name="res_model">ellaithy.whatsapp.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_whatsapp_conversation_search"/>
        <field name="context">{'search_default_my_conversations': 1}</field>
    </record>
</odoo>

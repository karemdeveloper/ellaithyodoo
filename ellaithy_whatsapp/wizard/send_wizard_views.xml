<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_send_wizard_form" model="ir.ui.view">
        <field name="name">ellaithy.whatsapp.send.wizard.form</field>
        <field name="model">ellaithy.whatsapp.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="conversation_id" readonly="1"/>
                    <field name="mode" widget="radio"/>
                    <field name="body" invisible="mode != 'text'" required="mode == 'text'"/>
                    <field name="template_id" invisible="mode != 'template'" required="mode == 'template'"/>
                    <field name="template_values" invisible="mode != 'template'"/>
                    <field name="media_type" invisible="mode != 'media'" required="mode == 'media'"/>
                    <field name="attachment_id" invisible="mode != 'media'" required="mode == 'media'"/>
                    <field name="caption" invisible="mode != 'media'"/>
                </group>
                <footer><button name="action_send" type="object" string="Send" class="btn-primary"/><button string="Cancel" special="cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>
